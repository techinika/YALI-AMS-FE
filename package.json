{
  "name": "amsfronted",
  "version": "0.1.0",
  "private": true,
  "description": "Alumni Management System for YALI Rwanda Chapter Frontend Codebase",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:lint": "supabase db lint",
    "db:diff": "supabase db diff",
    "types": "supabase gen types typescript --local > supabase/types/database.ts",
    "seed:generate": "node scripts/generate-reference-seed.mjs",
    "migrate:mysql": "node scripts/migrate-from-mysql/index.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.107.1",
    "accessibility": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.12",
    "exceljs": "^3.4.0",
    "file-saver": "^2.0.5",
    "lucide-react": "^1.27.0",
    "next": "^15.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0",
    "toastify-js": "^1.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/toastify-js": "^1.12.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "mysql2": "^3.0.0",
    "supabase": "^3.1.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true
  }
}
